{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "A customer toy order placed on ToyNest",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orderNumber": { "type": "string", "maxLength": 32 },
        "customerId": { "type": "string", "maxLength": 128 },
        "mode": { "type": "string", "enum": ["Child", "Adult"] },
        "productId": { "type": "string", "maxLength": 128 },
        "productName": { "type": "string", "maxLength": 200 },
        "productImageUrl": { "type": "string", "maxLength": 1000 },
        "price": { "type": "number" },
        "quantity": { "type": "number", "minimum": 1, "maximum": 5 },
        "unitPrice": { "type": "number" },
        "name": { "type": "string", "maxLength": 100 },
        "studentClass": { "type": "string", "maxLength": 50 },
        "section": { "type": "string", "maxLength": 50 },
        "phone": { "type": "string", "maxLength": 50 },
        "address": { "type": "string", "maxLength": 500 },
        "note": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "paymentRecipientName": { "type": "string", "maxLength": 100 },
        "paymentRecipientClass": { "type": "string", "maxLength": 50 },
        "paymentRecipientSection": { "type": "string", "maxLength": 50 },
        "ownerNote": { "type": "string", "maxLength": 500 },
        "queuePosition": { "type": "number" },
        "peopleAhead": { "type": "number" },
        "colour": { "type": "string", "maxLength": 100 },
        "aiVerification": { "type": "object", "description": "Playnix AI order risk inspection summary, flagged fields, owner decisions, and audit trail" }
      },
      "required": ["id", "orderNumber", "customerId", "mode", "productId", "productName", "price", "name", "status", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "A toy product available in the store",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "price": { "type": "number" },
        "category": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 2000 },
        "highlights": { "type": "array" },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "available": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "price", "category", "createdAt"]
    },
    "Suggestion": {
      "title": "Suggestion",
      "description": "A customer suggestion or toy request",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "suggestion": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "suggestion", "createdAt"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Store configuration and modes",
      "type": "object",
      "properties": {
        "adultPublished": { "type": "boolean" },
        "childPublished": { "type": "boolean" },
        "paymentQrUrl": { "type": "string", "maxLength": 1000 },
        "filamentCostPerGram": { "type": "number", "description": "Configured cost of 1 gram of filament in INR for the AI Filament Price Calculator" },
        "filamentCostUpdatedAt": { "type": "string", "maxLength": 64 },
        "list": { "type": "array" }
      }
    },
    "RescueDeal": {
      "title": "Rescue Deal",
      "description": "A single-quantity clearance or special rescue deal offer",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "originalPrice": { "type": "number" },
        "dealPrice": { "type": "number" },
        "condition": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "claimed": { "type": "boolean" },
        "status": { "type": "string", "maxLength": 50 },
        "claimedAt": { "type": "string", "maxLength": 64 },
        "claimedByOrder": { "type": "string", "maxLength": 128 },
        "claimedByCustomer": { "type": "string", "maxLength": 100 },
        "colour": { "type": "string", "maxLength": 100 },
        "deleted": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "title", "dealPrice", "claimed", "createdAt"]
    },
    "ScheduledOffer": {
      "title": "Scheduled Offer",
      "description": "A scheduled promotion or discounted offer with start and end times",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "productName": { "type": "string", "maxLength": 200 },
        "productImageUrl": { "type": "string", "maxLength": 1000 },
        "productCategory": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 200 },
        "originalPrice": { "type": "number" },
        "discountedPrice": { "type": "number" },
        "startAt": { "type": "string", "maxLength": 64 },
        "endAt": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "maxLength": 50 },
        "isDraft": { "type": "boolean" },
        "cancelled": { "type": "boolean" },
        "claimed": { "type": "boolean" },
        "claimedAt": { "type": "string", "maxLength": 64 },
        "claimedByOrder": { "type": "string", "maxLength": 128 },
        "claimedByCustomer": { "type": "string", "maxLength": 100 },
        "deleted": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "createdBy": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "productId", "title", "originalPrice", "discountedPrice", "startAt", "endAt", "status", "createdAt"]
    },
    "DiscountCampaign": {
      "title": "Discount Campaign",
      "description": "Festival-wide discount campaigns and scheduled sales",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "bannerImageUrl": { "type": "string", "maxLength": 1000 },
        "discountType": { "type": "string", "enum": ["percentage", "fixed"] },
        "discountValue": { "type": "number" },
        "targetScope": { "type": "string", "enum": ["all", "categories", "products"] },
        "targetCategories": { "type": "array" },
        "targetProductIds": { "type": "array" },
        "startAt": { "type": "string", "maxLength": 64 },
        "endAt": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "maxLength": 50 },
        "isDraft": { "type": "boolean" },
        "cancelled": { "type": "boolean" },
        "deleted": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "discountType", "discountValue", "targetScope", "startAt", "endAt", "status", "createdAt"]
    },
    "PopularSearch": {
      "title": "Popular Search",
      "description": "Owner-curated popular search suggestion chip for the customer search bar",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "term": { "type": "string", "maxLength": 100 },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "term", "order", "createdAt"]
    },
    "AnalyticsEvent": {
      "title": "Analytics Event",
      "description": "Deduplicated customer storefront event (visit, product_view, add_to_cart)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["visit", "product_view", "add_to_cart"] },
        "dateKey": { "type": "string", "maxLength": 16 },
        "customerId": { "type": "string", "maxLength": 128 },
        "sessionId": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "productName": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "count": { "type": "number" },
        "quantity": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "type", "dateKey", "customerId", "sessionId", "count", "createdAt"]
    },
    "AnalyticsCustomer": {
      "title": "Analytics Customer",
      "description": "Unique customer activity profile tracking visits, views, cart additions, and retention",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "customerId": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "isAuthenticated": { "type": "boolean" },
        "isGuest": { "type": "boolean" },
        "guestCode": { "type": "string", "maxLength": 16 },
        "linkedFromGuestId": { "type": "string", "maxLength": 128 },
        "mode": { "type": "string", "enum": ["Child", "Adult", "Visitor"] },
        "firstSeenAt": { "type": "string", "maxLength": 64 },
        "lastSeenAt": { "type": "string", "maxLength": 64 },
        "visitCount": { "type": "number" },
        "productViewCount": { "type": "number" },
        "cartAddCount": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "customerId", "firstSeenAt", "lastSeenAt", "visitCount", "createdAt"]
    },
    "CartItem": {
      "title": "Cart Item",
      "description": "An active item currently inside a customer shopping cart",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 100 },
        "isGuest": { "type": "boolean" },
        "guestCode": { "type": "string", "maxLength": 16 },
        "productId": { "type": "string", "maxLength": 128 },
        "productName": { "type": "string", "maxLength": 200 },
        "productImageUrl": { "type": "string", "maxLength": 1000 },
        "category": { "type": "string", "maxLength": 100 },
        "price": { "type": "number" },
        "colour": { "type": "string", "maxLength": 100 },
        "quantity": { "type": "number" },
        "addedAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "customerId", "productId", "productName", "price", "quantity", "addedAt"]
    },
    "ProductQuestion": {
      "title": "Product Question",
      "description": "A customer question linked to a specific product with optional customer name and owner answer",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "productName": { "type": "string", "maxLength": 200 },
        "productImageUrl": { "type": "string", "maxLength": 800000 },
        "customerId": { "type": "string", "maxLength": 128 },
        "guestCode": { "type": "string", "maxLength": 16 },
        "customerName": { "type": "string", "maxLength": 100 },
        "question": { "type": "string", "maxLength": 1000 },
        "answer": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["Pending", "Answered"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "answeredAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "productId", "productName", "customerId", "question", "status", "createdAt"]
    },
    "AiAssistantState": {
      "title": "Playnix AI Assistant State",
      "description": "Configuration, activation status, website scan summary, and training progress for Playnix AI Assistant",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "enabled": { "type": "boolean" },
        "hasCompletedInitialScan": { "type": "boolean" },
        "lastScannedAt": { "type": "string", "maxLength": 64 },
        "scanSummary": { "type": "string", "maxLength": 4000 },
        "learnedHighlights": { "type": "array" },
        "missingInfoItems": { "type": "array" },
        "trainingStatus": { "type": "string", "enum": ["not_started", "in_progress", "completed"] },
        "trainingCurrentStepIndex": { "type": "number" },
        "trainingCompletedAt": { "type": "string", "maxLength": 64 },
        "geminiConfigured": { "type": "boolean" },
        "responseStyleMode": { "type": "string", "enum": ["short_direct", "balanced", "detailed"] },
        "customInstructions": { "type": "string", "maxLength": 2000 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "enabled", "hasCompletedInitialScan", "trainingStatus", "trainingCurrentStepIndex", "updatedAt"]
    },
    "AiKnowledgeEntry": {
      "title": "Playnix AI Knowledge Entry",
      "description": "Verified website-derived or owner-provided knowledge base entry for Playnix AI Assistant",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 240 },
        "content": { "type": "string", "maxLength": 5000 },
        "category": { "type": "string", "enum": ["catalog", "product_spec", "delivery", "returns", "payment", "availability", "orders", "support", "faq", "policy", "tone"] },
        "source": { "type": "string", "enum": ["website", "owner"] },
        "productId": { "type": "string", "maxLength": 128 },
        "productName": { "type": "string", "maxLength": 200 },
        "trainingStepKey": { "type": "string", "maxLength": 64 },
        "verified": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "title", "content", "category", "source", "verified", "createdAt", "updatedAt"]
    },
    "AiTrainingAnswer": {
      "title": "Playnix AI Training Answer",
      "description": "Owner training interview response saved step-by-step for Playnix AI Assistant",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "stepKey": { "type": "string", "enum": ["delivery", "returns", "payment", "materials_specs", "availability", "order_processing", "customer_support", "faq", "unknown_fallback", "communication_style"] },
        "question": { "type": "string", "maxLength": 500 },
        "answer": { "type": "string", "maxLength": 4000 },
        "status": { "type": "string", "enum": ["pending", "answered", "skipped"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "stepKey", "question", "answer", "status", "createdAt", "updatedAt"]
    },
    "AiGuidanceQuestion": {
      "title": "Playnix AI Guidance Question",
      "description": "Dynamic question asked by Playnix AI when it needs owner guidance, missing product specs, or clarification",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "question": { "type": "string", "maxLength": 500 },
        "context": { "type": "string", "maxLength": 600 },
        "category": { "type": "string", "enum": ["catalog", "product_spec", "delivery", "returns", "payment", "availability", "orders", "support", "faq", "policy", "tone"] },
        "source": { "type": "string", "enum": ["scan", "customer_question", "ai_audit"] },
        "productId": { "type": "string", "maxLength": 128 },
        "productName": { "type": "string", "maxLength": 200 },
        "customerQuestionId": { "type": "string", "maxLength": 128 },
        "answer": { "type": "string", "maxLength": 4000 },
        "status": { "type": "string", "enum": ["open", "answered", "dismissed"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "answeredAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "question", "category", "source", "status", "createdAt", "updatedAt"]
    },
    "WatchdogAlert": {
      "title": "AI Watchdog Alert",
      "description": "Real-time detected anomaly or issue across orders, products, pricing, or website health",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 240 },
        "explanation": { "type": "string", "maxLength": 2000 },
        "recommendedAction": { "type": "string", "maxLength": 600 },
        "category": { "type": "string", "enum": ["orders", "products", "pricing", "website"] },
        "severity": { "type": "string", "enum": ["info", "warning", "critical"] },
        "status": { "type": "string", "enum": ["Pending", "Resolved", "Ignored"] },
        "targetType": { "type": "string", "enum": ["order", "product", "deal", "offer", "campaign", "website"] },
        "targetId": { "type": "string", "maxLength": 128 },
        "targetLabel": { "type": "string", "maxLength": 200 },
        "detectedBy": { "type": "string", "enum": ["rules", "gemini_ai"] },
        "detectedAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "resolvedAt": { "type": "string", "maxLength": 64 },
        "ownerNote": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "title", "explanation", "recommendedAction", "category", "severity", "status", "detectedBy", "detectedAt", "updatedAt"]
    },
    "WatchdogActivityLog": {
      "title": "AI Watchdog Activity Log",
      "description": "Immutable activity audit record of detected issues, scans, and owner decisions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "alertId": { "type": "string", "maxLength": 128 },
        "alertTitle": { "type": "string", "maxLength": 240 },
        "category": { "type": "string", "enum": ["orders", "products", "pricing", "website", "system"] },
        "action": { "type": "string", "enum": ["detected", "scan_completed", "ai_analyzed", "resolved", "ignored", "reopened", "auto_resolved"] },
        "actor": { "type": "string", "enum": ["AI Watchdog", "Gemini AI", "Owner"] },
        "details": { "type": "string", "maxLength": 1000 },
        "severity": { "type": "string", "enum": ["info", "warning", "critical"] },
        "at": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "category", "action", "actor", "details", "at"]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Collection of customer orders"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Collection of toy catalog items"
    },
    "/suggestions/{suggestionId}": {
      "schema": { "$ref": "#/entities/Suggestion" },
      "description": "Customer suggestions"
    },
    "/rescueDeals/{dealId}": {
      "schema": { "$ref": "#/entities/RescueDeal" },
      "description": "Single-quantity Rescue Deals offers"
    },
    "/scheduledOffers/{offerId}": {
      "schema": { "$ref": "#/entities/ScheduledOffer" },
      "description": "Time-scheduled promotional offers"
    },
    "/discountCampaigns/{campaignId}": {
      "schema": { "$ref": "#/entities/DiscountCampaign" },
      "description": "Festival-wide discount campaigns and scheduled sales"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/Setting" },
      "description": "Global shop settings"
    },
    "/popularSearches/{searchId}": {
      "schema": { "$ref": "#/entities/PopularSearch" },
      "description": "Owner-managed popular search terms for customers"
    },
    "/analyticsEvents/{eventId}": {
      "schema": { "$ref": "#/entities/AnalyticsEvent" },
      "description": "Deduplicated customer analytics events for visits, product views, and cart additions"
    },
    "/analyticsCustomers/{customerId}": {
      "schema": { "$ref": "#/entities/AnalyticsCustomer" },
      "description": "Unique customer activity summaries for analytics"
    },
    "/cartItems/{cartItemId}": {
      "schema": { "$ref": "#/entities/CartItem" },
      "description": "Active shopping cart items per customer for cross-device sync and owner analytics"
    },
    "/productQuestions/{questionId}": {
      "schema": { "$ref": "#/entities/ProductQuestion" },
      "description": "Product-linked customer questions and owner answers"
    },
    "/aiAssistantState/{stateId}": {
      "schema": { "$ref": "#/entities/AiAssistantState" },
      "description": "Playnix AI Assistant status, scan metadata, and training progress"
    },
    "/aiKnowledge/{entryId}": {
      "schema": { "$ref": "#/entities/AiKnowledgeEntry" },
      "description": "Playnix AI verified website-derived and owner-provided knowledge base entries"
    },
    "/aiTrainingAnswers/{stepId}": {
      "schema": { "$ref": "#/entities/AiTrainingAnswer" },
      "description": "Owner answers from the interactive Playnix AI training interview"
    },
    "/aiGuidanceQuestions/{questionId}": {
      "schema": { "$ref": "#/entities/AiGuidanceQuestion" },
      "description": "Questions generated by Playnix AI when it needs owner help or missing details"
    },
    "/watchdogAlerts/{alertId}": {
      "schema": { "$ref": "#/entities/WatchdogAlert" },
      "description": "Detected issues and monitoring alerts tracked by AI Watchdog"
    },
    "/watchdogLogs/{logId}": {
      "schema": { "$ref": "#/entities/WatchdogActivityLog" },
      "description": "Chronological activity log of Watchdog detections, scans, and owner alert decisions"
    }
  }
}
