rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Orders Collection:
    // Allows PIN-based owner and customer devices protected by Google Cloud domain restrictions
    match /orders/{orderId} {
      allow create: if isValidId(orderId)
        && request.resource.data.id is string
        && request.resource.data.orderNumber is string
        && request.resource.data.customerId is string
        && request.resource.data.customerId.size() <= 128
        && request.resource.data.productName is string
        && request.resource.data.productName.size() <= 200
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.status is string
        && (!('quantity' in request.resource.data) || (request.resource.data.quantity is number && request.resource.data.quantity >= 1 && request.resource.data.quantity <= 5));

      allow read: if true;
      allow update: if isValidId(orderId)
        && request.resource.data.price is number
        && request.resource.data.status is string;
      allow delete: if isValidId(orderId);
    }

    // Products Collection:
    match /products/{productId} {
      allow read: if true;
      allow write: if isValidId(productId)
        && (
          request.resource.data.deleted == true ||
          (request.resource.data.name is string && request.resource.data.price is number)
        );
      allow delete: if isValidId(productId);
    }

    // Suggestions Collection:
    match /suggestions/{suggestionId} {
      allow create: if isValidId(suggestionId)
        && request.resource.data.suggestion is string
        && request.resource.data.suggestion.size() <= 2000;
      allow read: if true;
      allow delete: if isValidId(suggestionId);
    }

    // Rescue Deals Collection:
    match /rescueDeals/{dealId} {
      allow read: if true;
      allow create: if isValidId(dealId)
        && (
          request.resource.data.deleted == true ||
          (request.resource.data.title is string && request.resource.data.dealPrice is number)
        );
      allow update: if isValidId(dealId);
      allow delete: if isValidId(dealId);
    }

    // Scheduled Offers Collection:
    match /scheduledOffers/{offerId} {
      allow read: if true;
      allow create: if isValidId(offerId)
        && (
          request.resource.data.deleted == true ||
          (
            request.resource.data.productId is string &&
            request.resource.data.title is string &&
            request.resource.data.originalPrice is number &&
            request.resource.data.discountedPrice is number
          )
        );
      allow update: if isValidId(offerId);
      allow delete: if isValidId(offerId);
    }

    // Discount Campaigns Collection:
    match /discountCampaigns/{campaignId} {
      allow read: if true;
      allow create: if isValidId(campaignId)
        && (
          request.resource.data.deleted == true ||
          (
            request.resource.data.name is string &&
            request.resource.data.discountValue is number
          )
        );
      allow update: if isValidId(campaignId);
      allow delete: if isValidId(campaignId);
    }

    // Settings Collection:
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }

    // Saved for Later Collection:
    match /savedItems/{savedItemId} {
      allow read: if true;
      allow create: if isValidId(savedItemId)
        && request.resource.data.customerId is string
        && request.resource.data.customerId.size() <= 128
        && request.resource.data.productId is string;
      allow update, delete: if isValidId(savedItemId);
    }

    // Cart Items Collection (Cross-device shopping cart persistence):
    match /cartItems/{cartItemId} {
      allow read: if true;
      allow create: if isValidId(cartItemId)
        && request.resource.data.customerId is string
        && request.resource.data.customerId.size() <= 128
        && request.resource.data.productId is string
        && (!('customerName' in request.resource.data) || (request.resource.data.customerName is string && request.resource.data.customerName.size() <= 100))
        && (!('guestCode' in request.resource.data) || (request.resource.data.guestCode is string && request.resource.data.guestCode.size() <= 16))
        && (!('isGuest' in request.resource.data) || request.resource.data.isGuest is bool);
      allow update: if isValidId(cartItemId)
        && request.resource.data.customerId is string
        && request.resource.data.customerId.size() <= 128
        && (!('customerName' in request.resource.data) || (request.resource.data.customerName is string && request.resource.data.customerName.size() <= 100))
        && (!('guestCode' in request.resource.data) || (request.resource.data.guestCode is string && request.resource.data.guestCode.size() <= 16))
        && (!('isGuest' in request.resource.data) || request.resource.data.isGuest is bool);
      allow delete: if isValidId(cartItemId);
    }

    // Popular Searches Collection:
    // Customers can read popular searches; owner workspace manages them
    match /popularSearches/{searchId} {
      allow read: if true;
      allow create, update: if isValidId(searchId)
        && request.resource.data.id is string
        && request.resource.data.term is string
        && request.resource.data.term.size() > 0
        && request.resource.data.term.size() <= 100
        && request.resource.data.order is number;
      allow delete: if isValidId(searchId);
    }

    // Analytics Events Collection:
    // Stores deduplicated visits, product views, and cart additions
    match /analyticsEvents/{eventId} {
      allow read: if true;
      allow create, update: if isValidId(eventId)
        && request.resource.data.id is string
        && request.resource.data.id.size() <= 128
        && request.resource.data.type in ['visit', 'product_view', 'add_to_cart']
        && request.resource.data.dateKey is string
        && request.resource.data.dateKey.size() == 10
        && request.resource.data.customerId is string
        && request.resource.data.customerId.size() <= 128
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() <= 128
        && request.resource.data.count is number
        && request.resource.data.count >= 1
        && request.resource.data.count <= 100000
        && (!('productId' in request.resource.data) || (request.resource.data.productId is string && request.resource.data.productId.size() <= 128))
        && (!('productName' in request.resource.data) || (request.resource.data.productName is string && request.resource.data.productName.size() <= 200))
        && (!('category' in request.resource.data) || (request.resource.data.category is string && request.resource.data.category.size() <= 100))
        && (!('quantity' in request.resource.data) || (request.resource.data.quantity is number && request.resource.data.quantity >= 0 && request.resource.data.quantity <= 100000));
    }

    // Analytics Customers Collection:
    // Tracks unique customer visits, product views, cart additions, and retention
    match /analyticsCustomers/{customerId} {
      allow read: if true;
      allow create, update: if isValidId(customerId)
        && request.resource.data.id is string
        && request.resource.data.id.size() <= 128
        && request.resource.data.customerId is string
        && request.resource.data.customerId.size() <= 128
        && request.resource.data.firstSeenAt is string
        && request.resource.data.firstSeenAt.size() <= 64
        && request.resource.data.lastSeenAt is string
        && request.resource.data.lastSeenAt.size() <= 64
        && request.resource.data.visitCount is number
        && request.resource.data.visitCount >= 0
        && (!('productViewCount' in request.resource.data) || (request.resource.data.productViewCount is number && request.resource.data.productViewCount >= 0))
        && (!('cartAddCount' in request.resource.data) || (request.resource.data.cartAddCount is number && request.resource.data.cartAddCount >= 0))
        && (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100))
        && (!('isAuthenticated' in request.resource.data) || request.resource.data.isAuthenticated is bool)
        && (!('isGuest' in request.resource.data) || request.resource.data.isGuest is bool)
        && (!('guestCode' in request.resource.data) || (request.resource.data.guestCode is string && request.resource.data.guestCode.size() <= 16))
        && (!('linkedFromGuestId' in request.resource.data) || (request.resource.data.linkedFromGuestId is string && request.resource.data.linkedFromGuestId.size() <= 128));
    }

    // Product Questions & Owner Answers Collection:
    function isValidProductQuestion(data) {
      return data.keys().hasAll(['id', 'productId', 'productName', 'customerId', 'question', 'status', 'createdAt'])
        && data.keys().hasOnly([
          'id',
          'productId',
          'productName',
          'productImageUrl',
          'customerId',
          'guestCode',
          'customerName',
          'question',
          'answer',
          'status',
          'createdAt',
          'answeredAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.productId is string
        && data.productId.size() > 0
        && data.productId.size() <= 128
        && data.productName is string
        && data.productName.size() > 0
        && data.productName.size() <= 200
        && (!('productImageUrl' in data) || (data.productImageUrl is string && data.productImageUrl.size() <= 800000))
        && data.customerId is string
        && data.customerId.size() > 0
        && data.customerId.size() <= 128
        && (!('guestCode' in data) || (data.guestCode is string && data.guestCode.size() <= 16))
        && (!('customerName' in data) || (data.customerName is string && data.customerName.size() <= 100))
        && data.question is string
        && data.question.size() > 0
        && data.question.size() <= 1000
        && (!('answer' in data) || (data.answer is string && data.answer.size() <= 2000))
        && data.status in ['Pending', 'Answered']
        && data.createdAt is string
        && data.createdAt.size() > 0
        && data.createdAt.size() <= 64
        && (!('answeredAt' in data) || (data.answeredAt is string && data.answeredAt.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    match /productQuestions/{questionId} {
      allow read: if true;
      allow create: if isValidId(questionId)
        && isValidProductQuestion(request.resource.data)
        && request.resource.data.id == questionId
        && request.resource.data.status == 'Pending'
        && (!('answer' in request.resource.data) || request.resource.data.answer == '');
      allow update: if isValidId(questionId)
        && isValidProductQuestion(request.resource.data)
        && request.resource.data.id == resource.data.id
        && request.resource.data.productId == resource.data.productId
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.question == resource.data.question
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'status', 'answeredAt', 'updatedAt']);
      allow delete: if isValidId(questionId);
    }

    // Playnix AI Assistant State Collection:
    function isValidAiAssistantState(data) {
      return data.keys().hasAll(['id', 'enabled', 'hasCompletedInitialScan', 'trainingStatus', 'trainingCurrentStepIndex', 'updatedAt'])
        && data.keys().hasOnly([
          'id',
          'enabled',
          'hasCompletedInitialScan',
          'lastScannedAt',
          'scanSummary',
          'learnedHighlights',
          'missingInfoItems',
          'trainingStatus',
          'trainingCurrentStepIndex',
          'trainingCompletedAt',
          'geminiConfigured',
          'responseStyleMode',
          'customInstructions',
          'updatedAt'
        ])
        && data.id == 'config'
        && data.enabled is bool
        && data.hasCompletedInitialScan is bool
        && (!('lastScannedAt' in data) || (data.lastScannedAt is string && data.lastScannedAt.size() <= 64))
        && (!('scanSummary' in data) || (data.scanSummary is string && data.scanSummary.size() <= 4000))
        && (!('learnedHighlights' in data) || (data.learnedHighlights is list && data.learnedHighlights.size() <= 40))
        && (!('missingInfoItems' in data) || (data.missingInfoItems is list && data.missingInfoItems.size() <= 60))
        && data.trainingStatus in ['not_started', 'in_progress', 'completed']
        && data.trainingCurrentStepIndex is number
        && data.trainingCurrentStepIndex >= 0
        && data.trainingCurrentStepIndex <= 20
        && (!('trainingCompletedAt' in data) || (data.trainingCompletedAt is string && data.trainingCompletedAt.size() <= 64))
        && (!('geminiConfigured' in data) || data.geminiConfigured is bool)
        && (!('responseStyleMode' in data) || data.responseStyleMode in ['short_direct', 'balanced', 'detailed'])
        && (!('customInstructions' in data) || (data.customInstructions is string && data.customInstructions.size() <= 2000))
        && data.updatedAt is string
        && data.updatedAt.size() <= 64;
    }

    match /aiAssistantState/{stateId} {
      allow read: if true;
      allow create, update: if isValidId(stateId)
        && stateId == 'config'
        && isValidAiAssistantState(request.resource.data);
      allow delete: if false;
    }

    // Playnix AI Knowledge Base Collection:
    function isValidAiKnowledgeEntry(data) {
      return data.keys().hasAll(['id', 'title', 'content', 'category', 'source', 'verified', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id',
          'title',
          'content',
          'category',
          'source',
          'productId',
          'productName',
          'trainingStepKey',
          'verified',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 240
        && data.content is string
        && data.content.size() > 0
        && data.content.size() <= 5000
        && data.category in ['catalog', 'product_spec', 'delivery', 'returns', 'payment', 'availability', 'orders', 'support', 'faq', 'policy', 'tone']
        && data.source in ['website', 'owner']
        && (!('productId' in data) || (data.productId is string && data.productId.size() <= 128))
        && (!('productName' in data) || (data.productName is string && data.productName.size() <= 200))
        && (!('trainingStepKey' in data) || (data.trainingStepKey is string && data.trainingStepKey.size() <= 64))
        && data.verified is bool
        && data.createdAt is string
        && data.createdAt.size() <= 64
        && data.updatedAt is string
        && data.updatedAt.size() <= 64;
    }

    match /aiKnowledge/{entryId} {
      allow read: if true;
      allow create, update: if isValidId(entryId)
        && request.resource.data.id == entryId
        && isValidAiKnowledgeEntry(request.resource.data);
      allow delete: if isValidId(entryId);
    }

    // Playnix AI Owner Training Interview Answers Collection:
    function isValidAiTrainingAnswer(data) {
      return data.keys().hasAll(['id', 'stepKey', 'question', 'answer', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id',
          'stepKey',
          'question',
          'answer',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == data.stepKey
        && data.stepKey in ['delivery', 'returns', 'payment', 'materials_specs', 'availability', 'order_processing', 'customer_support', 'faq', 'unknown_fallback', 'communication_style']
        && data.question is string
        && data.question.size() > 0
        && data.question.size() <= 500
        && data.answer is string
        && data.answer.size() <= 4000
        && data.status in ['pending', 'answered', 'skipped']
        && data.createdAt is string
        && data.createdAt.size() <= 64
        && data.updatedAt is string
        && data.updatedAt.size() <= 64;
    }

    match /aiTrainingAnswers/{stepId} {
      allow read: if true;
      allow create, update: if isValidId(stepId)
        && request.resource.data.id == stepId
        && isValidAiTrainingAnswer(request.resource.data);
      allow delete: if isValidId(stepId);
    }

    // Playnix AI Guidance Questions Collection (questions asked by AI when it needs help):
    function isValidAiGuidanceQuestion(data) {
      return data.keys().hasAll(['id', 'question', 'category', 'source', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id',
          'question',
          'context',
          'category',
          'source',
          'productId',
          'productName',
          'customerQuestionId',
          'answer',
          'status',
          'createdAt',
          'answeredAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.question is string
        && data.question.size() > 0
        && data.question.size() <= 500
        && (!('context' in data) || (data.context is string && data.context.size() <= 600))
        && data.category in ['catalog', 'product_spec', 'delivery', 'returns', 'payment', 'availability', 'orders', 'support', 'faq', 'policy', 'tone']
        && data.source in ['scan', 'customer_question', 'ai_audit']
        && (!('productId' in data) || (data.productId is string && data.productId.size() <= 128))
        && (!('productName' in data) || (data.productName is string && data.productName.size() <= 200))
        && (!('customerQuestionId' in data) || (data.customerQuestionId is string && data.customerQuestionId.size() <= 128))
        && (!('answer' in data) || (data.answer is string && data.answer.size() <= 4000))
        && data.status in ['open', 'answered', 'dismissed']
        && data.createdAt is string
        && data.createdAt.size() <= 64
        && (!('answeredAt' in data) || (data.answeredAt is string && data.answeredAt.size() <= 64))
        && data.updatedAt is string
        && data.updatedAt.size() <= 64;
    }

    match /aiGuidanceQuestions/{questionId} {
      allow read: if true;
      allow create, update: if isValidId(questionId)
        && request.resource.data.id == questionId
        && isValidAiGuidanceQuestion(request.resource.data);
      allow delete: if isValidId(questionId);
    }
  }
}
