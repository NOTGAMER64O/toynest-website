rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwnerAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'sanyukta.mehtaa@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Orders Collection:
    // Anyone can create their own order with valid schema fields.
    // Customers can look up their own specific order by ID (get).
    // Listing all orders, updating statuses, or deleting orders is strictly restricted to authorized administrators.
    match /orders/{orderId} {
      allow create: if isValidId(orderId)
        && request.resource.data.id is string
        && request.resource.data.orderNumber is string
        && request.resource.data.customerId is string
        && request.resource.data.customerId.size() <= 128
        && request.resource.data.productName is string
        && request.resource.data.productName.size() <= 200
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.status is string;

      // Specific order document retrieval by ID
      allow get: if isOwnerAdmin() || (resource.data.customerId != null);

      // Listing all customer orders is strictly restricted to authorized administrators
      allow list: if isOwnerAdmin();

      // Modifying or deleting customer orders is strictly restricted to authorized administrators
      allow update, delete: if isOwnerAdmin();
    }

    // Products Collection:
    // Product catalog is readable by all visitors.
    // Products can only be created, modified, or deleted by authorized administrators.
    match /products/{productId} {
      allow read: if true;
      allow write, delete: if isOwnerAdmin();
    }

    // Suggestions Collection:
    // Customers can submit suggestions.
    // Only authorized administrators can view or delete suggestions.
    match /suggestions/{suggestionId} {
      allow create: if isValidId(suggestionId)
        && request.resource.data.suggestion is string
        && request.resource.data.suggestion.size() <= 2000;
      allow read, delete: if isOwnerAdmin();
    }

    // Settings Collection:
    // Settings (payment QR, store modes) are readable by all visitors.
    // Only authorized administrators can modify settings.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isOwnerAdmin();
    }

    // Admins Collection:
    // Internal admin roles, readable and writable only by authorized administrators.
    match /admins/{adminId} {
      allow read, write: if isOwnerAdmin();
    }
  }
}
