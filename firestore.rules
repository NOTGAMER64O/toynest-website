rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Orders Collection:
    // Allows PIN-based owner and customer devices protected by Google Cloud domain restrictions
    match /orders/{orderId} {
      allow create: if isValidId(orderId)
        && request.resource.data.id is string
        && request.resource.data.orderNumber is string
        && request.resource.data.customerId is string
        && request.resource.data.customerId.size() <= 128
        && request.resource.data.productName is string
        && request.resource.data.productName.size() <= 200
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.status is string
        && (!('quantity' in request.resource.data) || (request.resource.data.quantity is number && request.resource.data.quantity >= 1 && request.resource.data.quantity <= 5));

      allow read: if true;
      allow update: if isValidId(orderId)
        && request.resource.data.price is number
        && request.resource.data.status is string;
      allow delete: if isValidId(orderId);
    }

    // Products Collection:
    match /products/{productId} {
      allow read: if true;
      allow write: if isValidId(productId)
        && (
          request.resource.data.deleted == true ||
          (request.resource.data.name is string && request.resource.data.price is number)
        );
      allow delete: if isValidId(productId);
    }

    // Suggestions Collection:
    match /suggestions/{suggestionId} {
      allow create: if isValidId(suggestionId)
        && request.resource.data.suggestion is string
        && request.resource.data.suggestion.size() <= 2000;
      allow read: if true;
      allow delete: if isValidId(suggestionId);
    }

    // Rescue Deals Collection:
    match /rescueDeals/{dealId} {
      allow read: if true;
      allow create: if isValidId(dealId)
        && (
          request.resource.data.deleted == true ||
          (request.resource.data.title is string && request.resource.data.dealPrice is number)
        );
      allow update: if isValidId(dealId);
      allow delete: if isValidId(dealId);
    }

    // Scheduled Offers Collection:
    match /scheduledOffers/{offerId} {
      allow read: if true;
      allow create: if isValidId(offerId)
        && (
          request.resource.data.deleted == true ||
          (
            request.resource.data.productId is string &&
            request.resource.data.title is string &&
            request.resource.data.originalPrice is number &&
            request.resource.data.discountedPrice is number
          )
        );
      allow update: if isValidId(offerId);
      allow delete: if isValidId(offerId);
    }

    // Discount Campaigns Collection:
    match /discountCampaigns/{campaignId} {
      allow read: if true;
      allow create: if isValidId(campaignId)
        && (
          request.resource.data.deleted == true ||
          (
            request.resource.data.name is string &&
            request.resource.data.discountValue is number
          )
        );
      allow update: if isValidId(campaignId);
      allow delete: if isValidId(campaignId);
    }

    // Settings Collection:
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }

    // Saved for Later Collection:
    match /savedItems/{savedItemId} {
      allow read: if true;
      allow create: if isValidId(savedItemId)
        && request.resource.data.customerId is string
        && request.resource.data.customerId.size() <= 128
        && request.resource.data.productId is string;
      allow update, delete: if isValidId(savedItemId);
    }

    // Cart Items Collection (Cross-device shopping cart persistence):
    match /cartItems/{cartItemId} {
      allow read: if true;
      allow create: if isValidId(cartItemId)
        && request.resource.data.customerId is string
        && request.resource.data.customerId.size() <= 128
        && request.resource.data.productId is string
        && (!('customerName' in request.resource.data) || (request.resource.data.customerName is string && request.resource.data.customerName.size() <= 100))
        && (!('guestCode' in request.resource.data) || (request.resource.data.guestCode is string && request.resource.data.guestCode.size() <= 16))
        && (!('isGuest' in request.resource.data) || request.resource.data.isGuest is bool);
      allow update: if isValidId(cartItemId)
        && request.resource.data.customerId is string
        && request.resource.data.customerId.size() <= 128
        && (!('customerName' in request.resource.data) || (request.resource.data.customerName is string && request.resource.data.customerName.size() <= 100))
        && (!('guestCode' in request.resource.data) || (request.resource.data.guestCode is string && request.resource.data.guestCode.size() <= 16))
        && (!('isGuest' in request.resource.data) || request.resource.data.isGuest is bool);
      allow delete: if isValidId(cartItemId);
    }

    // Popular Searches Collection:
    // Customers can read popular searches; owner workspace manages them
    match /popularSearches/{searchId} {
      allow read: if true;
      allow create, update: if isValidId(searchId)
        && request.resource.data.id is string
        && request.resource.data.term is string
        && request.resource.data.term.size() > 0
        && request.resource.data.term.size() <= 100
        && request.resource.data.order is number;
      allow delete: if isValidId(searchId);
    }

    // Analytics Events Collection:
    // Stores deduplicated visits, product views, and cart additions
    match /analyticsEvents/{eventId} {
      allow read: if true;
      allow create, update: if isValidId(eventId)
        && request.resource.data.id is string
        && request.resource.data.id.size() <= 128
        && request.resource.data.type in ['visit', 'product_view', 'add_to_cart']
        && request.resource.data.dateKey is string
        && request.resource.data.dateKey.size() == 10
        && request.resource.data.customerId is string
        && request.resource.data.customerId.size() <= 128
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() <= 128
        && request.resource.data.count is number
        && request.resource.data.count >= 1
        && request.resource.data.count <= 100000
        && (!('productId' in request.resource.data) || (request.resource.data.productId is string && request.resource.data.productId.size() <= 128))
        && (!('productName' in request.resource.data) || (request.resource.data.productName is string && request.resource.data.productName.size() <= 200))
        && (!('category' in request.resource.data) || (request.resource.data.category is string && request.resource.data.category.size() <= 100))
        && (!('quantity' in request.resource.data) || (request.resource.data.quantity is number && request.resource.data.quantity >= 0 && request.resource.data.quantity <= 100000));
    }

    // Analytics Customers Collection:
    // Tracks unique customer visits, product views, cart additions, and retention
    match /analyticsCustomers/{customerId} {
      allow read: if true;
      allow create, update: if isValidId(customerId)
        && request.resource.data.id is string
        && request.resource.data.id.size() <= 128
        && request.resource.data.customerId is string
        && request.resource.data.customerId.size() <= 128
        && request.resource.data.firstSeenAt is string
        && request.resource.data.firstSeenAt.size() <= 64
        && request.resource.data.lastSeenAt is string
        && request.resource.data.lastSeenAt.size() <= 64
        && request.resource.data.visitCount is number
        && request.resource.data.visitCount >= 0
        && (!('productViewCount' in request.resource.data) || (request.resource.data.productViewCount is number && request.resource.data.productViewCount >= 0))
        && (!('cartAddCount' in request.resource.data) || (request.resource.data.cartAddCount is number && request.resource.data.cartAddCount >= 0))
        && (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100))
        && (!('isAuthenticated' in request.resource.data) || request.resource.data.isAuthenticated is bool)
        && (!('isGuest' in request.resource.data) || request.resource.data.isGuest is bool)
        && (!('guestCode' in request.resource.data) || (request.resource.data.guestCode is string && request.resource.data.guestCode.size() <= 16))
        && (!('linkedFromGuestId' in request.resource.data) || (request.resource.data.linkedFromGuestId is string && request.resource.data.linkedFromGuestId.size() <= 128));
    }
  }
}
