rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Orders Collection:
    // Allows PIN-based owner and customer devices protected by Google Cloud domain restrictions
    match /orders/{orderId} {
      allow create: if isValidId(orderId)
        && request.resource.data.id is string
        && request.resource.data.orderNumber is string
        && request.resource.data.customerId is string
        && request.resource.data.customerId.size() <= 128
        && request.resource.data.productName is string
        && request.resource.data.productName.size() <= 200
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.status is string
        && (!('quantity' in request.resource.data) || (request.resource.data.quantity is number && request.resource.data.quantity >= 1 && request.resource.data.quantity <= 5));

      allow read: if true;
      allow update: if isValidId(orderId)
        && request.resource.data.price is number
        && request.resource.data.status is string;
      allow delete: if isValidId(orderId);
    }

    // Products Collection:
    match /products/{productId} {
      allow read: if true;
      allow write: if isValidId(productId)
        && (
          request.resource.data.deleted == true ||
          (request.resource.data.name is string && request.resource.data.price is number)
        );
      allow delete: if isValidId(productId);
    }

    // Suggestions Collection:
    match /suggestions/{suggestionId} {
      allow create: if isValidId(suggestionId)
        && request.resource.data.suggestion is string
        && request.resource.data.suggestion.size() <= 2000;
      allow read: if true;
      allow delete: if isValidId(suggestionId);
    }

    // Rescue Deals Collection:
    match /rescueDeals/{dealId} {
      allow read: if true;
      allow create: if isValidId(dealId)
        && request.resource.data.title is string
        && request.resource.data.dealPrice is number;
      allow update: if isValidId(dealId);
      allow delete: if isValidId(dealId);
    }

    // Settings Collection:
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }
  }
}
